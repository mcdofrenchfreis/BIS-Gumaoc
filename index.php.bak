<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GUMAOC East — Portal Selection</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg-overlay: rgba(23, 43, 33, 0.65);
      --card-bg: rgba(255, 255, 255, 0.92);
      --text-main: #17261f;
      --text-subtle: #4b5d54;
      --brand: #2e7d32;
      --brand-strong: #1b5e20;
      --ring: rgba(46, 125, 50, 0.25);
      --shadow-strong: 0 12px 40px rgba(0, 0, 0, 0.25);
      --shadow-soft: 0 8px 28px rgba(0, 0, 0, 0.15);
    }
    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      margin: 0;
      font-family: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      color: var(--text-main);
      background:
        linear-gradient(var(--bg-overlay), var(--bg-overlay)),
        url('assets/images/background.jpg') center / cover no-repeat fixed;
      display: grid;
      place-items: center;
    }
    .wrap { width: min(1024px, 92vw); margin: 4vh auto; }
    .panel {
      background: var(--card-bg);
      backdrop-filter: saturate(150%) blur(8px);
      border: 1px solid rgba(0, 0, 0, 0.06);
      border-radius: 20px;
      box-shadow: var(--shadow-strong);
      overflow: hidden;
    }
    .panel-header {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 16px;
      padding: 22px 24px;
      background: linear-gradient(135deg, var(--brand-strong), var(--brand));
      color: #fff;
    }
    .logo {
      width: 54px; height: 54px; border-radius: 14px;
      display: grid; place-items: center;
      background: linear-gradient(135deg, rgba(255,255,255,.25), rgba(255,255,255,.12));
      border: 1px solid rgba(255,255,255,.35);
      font-weight: 800; letter-spacing: .5px;
      text-shadow: 0 2px 8px rgba(0,0,0,.25);
    }
    .title h1 { margin: 0; font-size: 1.35rem; font-weight: 800; letter-spacing: .3px; }
    .title p { margin: 2px 0 0; opacity: .9; font-weight: 500; font-size: .98rem; }
    .panel-body { padding: 28px; background: linear-gradient(180deg, rgba(255,255,255,.75), rgba(255,255,255,.95)); }
    .intro { text-align: center; margin: 4px 0 22px; }
    .intro h2 { margin: 0 0 6px; font-weight: 800; letter-spacing: .2px; color: var(--brand-strong); font-size: clamp(1.25rem, 2.4vw, 1.6rem); }
    .intro p { margin: 0; color: var(--text-subtle); font-weight: 500; }
    .grid { display: grid; grid-template-columns: repeat(2, minmax(220px, 1fr)); gap: 16px; margin-top: 18px; }
    @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
    .card {
      position: relative; display: grid; gap: 10px; padding: 18px 18px; background: #fff;
      border: 1px solid rgba(27, 43, 34, 0.08); border-radius: 16px; text-decoration: none; color: var(--text-main);
      box-shadow: var(--shadow-soft); transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; isolation: isolate;
    }
    .card:hover { transform: translateY(-4px); box-shadow: 0 16px 36px rgba(0,0,0,.18); border-color: var(--ring); }
    .card:focus-visible { outline: 0; box-shadow: 0 0 0 4px var(--ring); }
    .card .badge {
      position: absolute; top: 12px; right: 12px; font-size: 12px; font-weight: 700;
      background: linear-gradient(135deg, #e8f5e9, #ffffff); color: var(--brand-strong); border: 1px solid #c8e6c9;
      padding: 4px 8px; border-radius: 999px;
    }
    .card .icon {
      font-size: 28px; line-height: 1; width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center;
      background: linear-gradient(135deg, rgba(46,125,50,.08), rgba(46,125,50,.02)); color: var(--brand-strong); border: 1px solid rgba(46,125,50,.18);
    }
    .card h3 { margin: 2px 0 0; font-size: 1.05rem; font-weight: 800; }
    .card p { margin: 0; color: var(--text-subtle); font-weight: 500; }
    .row { display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center; }
    .actions { display: grid; grid-auto-flow: column; gap: 10px; }
    .btn {
      display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 12px; border: 1px solid rgba(0,0,0,.07);
      background: linear-gradient(135deg, #ffffff, #f8faf9); color: var(--text-main); text-decoration: none; font-weight: 700; font-size: .95rem;
      transition: transform .18s ease, box-shadow .18s ease;
    }
    .btn:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0,0,0,.12); }
    .btn.primary { background: linear-gradient(135deg, var(--brand), var(--brand-strong)); color: #fff; border-color: rgba(255,255,255,.25); }
    .btn.warn { background: linear-gradient(135deg, #fb8c00, #ef6c00); color: #fff; border-color: rgba(255,255,255,.25); }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="panel">
      <div class="panel-header">
        <div class="logo">BRGY</div>
        <div class="title">
          <h1>Barangay Gumaoc East</h1>
          <p>Digital Services and Administration</p>
        </div>
        <div class="actions">
          <a class="btn" href="pages/about.php">About</a>
          <a class="btn" href="pages/contact.php">Contact</a>
        </div>
      </div>
      <div class="panel-body">
        <div class="intro">
          <h2>Select a portal to continue</h2>
          <p>Choose the appropriate portal based on your role or activity</p>
        </div>

        <div class="grid">
          <a class="card" href="kiosk/index.php">
            <span class="badge">Public</span>
            <div class="row">
              <div class="icon">🖥️</div>
              <div>
                <h3>Kiosk</h3>
                <p>Self-service access for residents and visitors</p>
              </div>
            </div>
          </a>

          <a class="card" href="user/login.php">
            <span class="badge" style="background: linear-gradient(135deg, #e3f2fd, #ffffff); color:#0d47a1; border-color:#bbdefb;">Resident</span>
            <div class="row">
              <div class="icon" style="color:#0d47a1; border-color: rgba(13,71,161,.25); background: linear-gradient(135deg, rgba(13,71,161,.08), rgba(13,71,161,.02));">👤</div>
              <div>
                <h3>User Portal</h3>
                <p>Login to manage requests, notifications, and settings</p>
              </div>
            </div>
          </a>
        </div>

        <div style="margin-top: 18px; display: grid; grid-auto-flow: column; gap: 10px; justify-content: center;">
          <a class="btn" href="pages/services.php">View Services</a>
          <a class="btn primary" href="pages/forms.php">Request Document</a>
          <a class="btn warn" href="pages/report.php">Report Emergency</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
